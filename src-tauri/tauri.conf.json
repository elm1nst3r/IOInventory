{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IO Inventory",
  "version": "0.24.0",
  "identifier": "com.ioinventory.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run mcp:build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IO Inventory",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMkI3NTE3Mjk2NEE1MzEKUldReHBXUXBGM1Vyc2JaQXJ3a3puQXF5NGM0ZTNYdWFySzdaN3JCbTQyWVdVVVM0dVZCZ1JkS0gK",
      "endpoints": [
        "https://github.com/elm1nst3r/IOInventory/releases/latest/download/latest.json"
      ]
    }
  }
}
